# Copy to .env and fill in. Every secret below is blank on purpose: .env holds
# live credentials and is never committed, and this file must never hold them.

# ==========================================================
# Authentication — your Supabase project
# ==========================================================
# Accounts live in Supabase Auth (auth.users) plus the public.profiles table.
# Run backend/app/authentification/schema.sql once in the Supabase SQL editor
# before the first sign-in.
#
# Dashboard -> Project Settings -> API keys
SUPABASE_URL=

# Publishable / anon key (sb_publishable_... or the legacy anon JWT).
# Safe to expose; used for sign up, sign in and refresh.
SUPABASE_PUBLISHABLE_KEY=

# Secret / service_role key (sb_secret_... or the legacy service_role JWT).
# Bypasses Row Level Security — needed to read roles and to administer accounts.
# NEVER put this in the frontend.
SUPABASE_SECRET_KEY=

# Only for projects still on the legacy shared HS256 JWT secret. Projects with
# asymmetric signing keys (the current default) leave this empty — the backend
# verifies tokens against the public JWKS instead.
SUPABASE_JWT_SECRET=

# Where Supabase sends people after they click a confirmation or reset link.
# Both must be listed under Authentication -> URL Configuration -> Redirect URLs.
AUTH_EMAIL_REDIRECT_URL=http://localhost:8080/dashboard
AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:8080/auth

# Mirrors the minimum length set in Authentication -> Providers -> Email, so the
# API can reject a short password with a clear message.
AUTH_PASSWORD_MIN_LENGTH=8

# New accounts are created already confirmed, through Supabase's admin API,
# which sends no email. Supabase's built-in mail sender allows only a couple of
# messages an hour ("email rate limit exceeded" after two or three sign-ups),
# so leaving this off means nobody can register. The trade-off: no address is
# ever verified. Set it to false once real SMTP is configured in Supabase.
AUTH_AUTOCONFIRM_SIGNUP=true

# Session cookies. Secure must be true anywhere the app is served over https,
# and must stay false for http://localhost or the browser drops the cookie.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# ==========================================================
# False data injection detection — app/fdi
# ==========================================================
# Where the detector artifact lives. Both are read by app/fdi/config.py and
# default to exactly these values, so a retrained model is a redeploy away and
# never a source edit. Leave them alone unless you are retargeting.
FDI_HF_REPO_ID=YOUR_HF_ACCOUNT/mirsaad-models
FDI_HF_FILENAME=oneclass_hybride_v5.joblib

# Optional local artifact. Anything set here skips the Hub download entirely,
# for training machines that already have the file.
FDI_MODEL_PATH=

# The Hub repo is private, so the first run needs a token. Read from the
# environment only — never a constant in source and never returned by the API.
# The artifact is cached in the normal HF cache once it has been fetched.
HF_TOKEN=

# ==========================================================
# AI copilot — app/ai
# ==========================================================
# Groq API key. Named `groq_model` because that is what the working .env
# already calls it; GROQ_API_KEY is accepted as an alias. Despite the name the
# value is a key (gsk_...), not a model.
groq_model=

# Any Groq-hosted chat model. gpt-oss-120b answers these two-sentence prompts
# in well under a second.
GROQ_MODEL_NAME=openai/gpt-oss-120b

# gpt-oss spends part of its completion budget on hidden reasoning tokens, so
# this is reasoning + answer, not answer alone. Too low and the reply comes
# back empty because the budget ran out mid-thought.
GROQ_MAX_TOKENS=1024

# low / medium / high. Every prompt here asks for two or three sentences, and
# past "low" deeper reasoning mostly buys tokens rather than insight.
GROQ_REASONING_EFFORT=low

GROQ_TEMPERATURE=1

# These calls sit in front of the dashboard, so a slow answer is worse than
# none — past this the copilot panel says it is unavailable and the app
# carries on.
GROQ_TIMEOUT=20
